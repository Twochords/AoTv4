<?xml version="1.0" encoding="us-ascii"?>
<XML ID="EQInterfaceDefinitionLanguage">
	<Schema xmlns="EverQuestData" xmlns:dt="EverQuestDataTypes" />

	<!-- AoTv4 Zone Difficulty window (CCustomWnd "AoTDifficultyWnd"), opened by "/pick".

	     Difficulty is a property of the CHARACTER, not a destination: pick one here and it applies
	     to every zone you enter from then on, by placing you in a private copy of that zone shared
	     with everyone else at the same difficulty.  Normal is the real zone with no instance.

	     Deliberately NOT the native /pick window.  OP_PickZoneWindow exists and is mapped for RoF2,
	     but PickZoneEntry_Struct carries only zone_id, player_count and instance_id, with no text
	     field at all, so every difficulty would render as the same zone name with a different
	     population.  Handle_OP_PickZone is also a bare stub server side and nothing has ever sent
	     the window packet.  The dll intercepts the command instead.

	     NO TabBox here, deliberately.  Native tabs are the right widget when each page owns its own
	     controls (the Delve window has two such pages); this is one list, one description pane and
	     one button, so a tab strip would cost height and buy nothing.

	     Comments must never contain a double hyphen, which is illegal in XML and makes the SIDL
	     parser abort the WHOLE file, killing the client before character select.  Run
	     aotv4_client_install/validate_ui_xml.sh before copying this anywhere. -->

	<Label item="ZDF_Hint">
		<ScreenID>ZDF_Hint</ScreenID>
		<RelativePosition>true</RelativePosition>
		<Location><X>10</X><Y>6</Y></Location>
		<Size><CX>300</CX><CY>16</CY></Size>
		<Text>Select a difficulty, then Travel</Text>
		<NoWrap>true</NoWrap>
		<TextColor><R>240</R><G>200</G><B>120</B></TextColor>
	</Label>

	<Button item="ZDF_Refresh">
		<ScreenID>ZDF_Refresh</ScreenID>
		<RelativePosition>true</RelativePosition>
		<Location><X>322</X><Y>4</Y></Location>
		<Size><CX>76</CX><CY>20</CY></Size>
		<Text>Refresh</Text>
		<TextColor><R>230</R><G>230</G><B>230</B></TextColor>
		<Template>BDT_Normal</Template>
	</Button>

	<!-- The "Now" column is how the window says where you are.  A latched or highlighted row cannot
	     be set reliably from code on this build, which is the same reason the Allaclone window shows
	     its active mode by rewriting the button label. -->
	<Listbox item="ZDF_List">
		<ScreenID>ZDF_List</ScreenID>
		<DrawTemplate>WDT_Inner</DrawTemplate>
		<RelativePosition>true</RelativePosition>
		<Location><X>10</X><Y>26</Y></Location>
		<Size><CX>388</CX><CY>104</CY></Size>
		<TextColor><R>255</R><G>255</G><B>255</B></TextColor>
		<Style_Border>true</Style_Border>
		<Style_VScroll>true</Style_VScroll>
		<Columns><Width>36</Width><Heading>Now</Heading></Columns>
		<Columns><Width>118</Width><Heading>Difficulty</Heading></Columns>
		<Columns><Width>78</Width><Heading>Health</Heading></Columns>
		<Columns><Width>74</Width><Heading>Levels</Heading></Columns>
		<Columns><Width>78</Width><Heading>Damage</Heading></Columns>
	</Listbox>

	<STMLbox item="ZDF_Desc">
		<ScreenID>ZDF_Desc</ScreenID>
		<DrawTemplate>WDT_Inner</DrawTemplate>
		<RelativePosition>true</RelativePosition>
		<Location><X>10</X><Y>136</Y></Location>
		<Size><CX>388</CX><CY>92</CY></Size>
		<Style_Border>true</Style_Border>
		<Style_VScroll>true</Style_VScroll>
		<TextColor><R>230</R><G>230</G><B>230</B></TextColor>
	</STMLbox>

	<!-- Port Group.  A checkbox is a Button carrying Style_Checkbox; there is no Checkbox tag on this
	     client build.  BDT_CheckboxWithText carries its own caption, so no separate Label is needed.
	     The dll rewrites this caption to [X] / [  ] because the checked and unchecked art differ by
	     little more than a tint, which was reported as unreadable on the Travel window. -->
	<Button item="ZDF_Group">
		<ScreenID>ZDF_Group</ScreenID>
		<RelativePosition>true</RelativePosition>
		<Location><X>12</X><Y>234</Y></Location>
		<Size><CX>155</CX><CY>18</CY></Size>
		<Text>Port Group</Text>
		<TextColor><R>230</R><G>230</G><B>230</B></TextColor>
		<Style_Checkbox>true</Style_Checkbox>
		<Template>BDT_CheckboxWithText</Template>
		<TooltipReference>Shift your whole group.  Everyone must be in this zone, out of combat, off cooldown and not in a delve</TooltipReference>
	</Button>

	<!-- Travel.  120x22 is a stock EQ button size.  It was CX 388 in a 420 wide window: BDT_Normal is a
	     small bitmap template and the UI engine SCALES it to whatever Size it is given, so a button
	     three times its art's natural width blurs at every edge.  Nothing warns about this. -->
	<Button item="ZDF_Travel">
		<ScreenID>ZDF_Travel</ScreenID>
		<RelativePosition>true</RelativePosition>
		<Location><X>150</X><Y>258</Y></Location>
		<Size><CX>120</CX><CY>22</CY></Size>
		<Text>Travel</Text>
		<TextColor><R>255</R><G>200</G><B>140</B></TextColor>
		<Template>BDT_Normal</Template>
		<TooltipReference>Move to the selected difficulty in this zone.  Zoning anywhere else returns you to Normal</TooltipReference>
	</Button>

	<Screen item="AoTDifficultyWnd">
		<RelativePosition>false</RelativePosition>
		<Location><X>260</X><Y>160</Y></Location>
		<Size><CX>420</CX><CY>300</CY></Size>
		<Text>Zone Difficulty</Text>
		<Style_Transparent>false</Style_Transparent>
		<DrawTemplate>WDT_Def</DrawTemplate>
		<Style_Titlebar>true</Style_Titlebar>
		<Style_Closebox>true</Style_Closebox>
		<Style_Border>true</Style_Border>
		<Style_Sizable>false</Style_Sizable>
		<Pieces>ZDF_Hint</Pieces>
		<Pieces>ZDF_Refresh</Pieces>
		<Pieces>ZDF_List</Pieces>
		<Pieces>ZDF_Desc</Pieces>
		<Pieces>ZDF_Group</Pieces>
		<Pieces>ZDF_Travel</Pieces>
	</Screen>

</XML>
